{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/arch_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew :core:jvmTest*)",
      "Bash(./gradlew :core:allTests*)",
      "Bash(./gradlew :core:compile*)"
    ]
  }
}
